import "@typespec/http";
import "@typespec/spector";
import "@azure-tools/typespec-client-generator-core";

using Http;
using global.Azure.ClientGenerator.Core;
using Spector;

@doc("Test decorator @scope for filtering operations and properties by emitter.")
@scenarioService("/azure/client-generator-core/scope")
@global.Azure.ClientGenerator.Core.clientNamespace("azure.clientgenerator.core.scope", "java")
namespace _Specs_.Azure.ClientGenerator.Core.Scope;

model ScopedModel {
  @doc("Name property available to all emitters.")
  name: string;
}

@scenario
@scenarioDoc("""
  This scenario tests that operations decorated with @scope are only generated for the specified emitter.
  The 'allEmitters' operation has no @scope and should be generated by all emitters.
  
  Expected response body:
  ```json
  {
    "name": "all"
  }
  ```
  """)
@route("/all")
@get
op allEmitters(): ScopedModel;

@scenario
@scenarioDoc("""
  This scenario tests the @scope decorator with a positive scope.
  The 'pythonOnly' operation is scoped to Python and should only be generated by the Python emitter.
  Other emitters should skip this operation.
  
  Expected response body:
  ```json
  {
    "name": "python"
  }
  ```
  """)
@route("/python-only")
@get
@scope("python")
op pythonOnly(): ScopedModel;

@scenario
@scenarioDoc("""
  This scenario tests the @scope decorator with negation scope.
  The 'excludeCsharp' operation is scoped to "!csharp" and should be generated by all emitters except C#.
  
  Expected response body:
  ```json
  {
    "name": "not-csharp"
  }
  ```
  """)
@route("/exclude-csharp")
@get
@scope("!csharp")
op excludeCsharp(): ScopedModel;
